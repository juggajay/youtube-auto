## Part 1: Database

### Content Library Table

```sql
create table content_library (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references auth.users(id) on delete cascade,
  
  -- Basic info
  name text not null,
  type text not null check (type in ('hook', 'title', 'description', 'intro', 'cta', 'outline', 'script')),
  content text not null,
  tags text[] default '{}',
  
  -- Context (what video/topic this was created for)
  topic text,
  archetype text,
  
  -- Metadata
  metadata jsonb default '{}',
  
  -- Usage tracking
  used_count int default 0,
  last_used_at timestamp,
  
  -- Timestamps
  created_at timestamp default now(),
  updated_at timestamp default now()
);

-- Indexes
create index idx_content_library_user_id on content_library(user_id);
create index idx_content_library_user_type on content_library(user_id, type);
create index idx_content_library_tags on content_library using gin(tags);
create index idx_content_library_search on content_library using gin(
  to_tsvector('english', name || ' ' || content || ' ' || coalesce(topic, ''))
);

-- RLS Policies
alter table content_library enable row level security;

create policy "Users can view own content"
  on content_library for select
  using (auth.uid() = user_id);

create policy "Users can insert own content"
  on content_library for insert
  with check (auth.uid() = user_id);

create policy "Users can update own content"
  on content_library for update
  using (auth.uid() = user_id);

create policy "Users can delete own content"
  on content_library for delete
  using (auth.uid() = user_id);
```

### Content Types Explained

| Type | What It Is | Example |
|------|-----------|---------|
| `hook` | Opening line to grab attention | "Everyone's using n8n wrong. Here's why..." |
| `title` | YouTube video title | "The Ultimate n8n Tutorial for Beginners (2024)" |
| `description` | Full video description | Multi-line with timestamps, links, CTA |
| `intro` | Introduction paragraph after hook | "In this video, we'll cover everything you need..." |
| `cta` | Call-to-action text | "If you found this helpful, smash that like button..." |
| `outline` | Script structure/sections | "1. Hook 2. Problem 3. Solution 4. Demo 5. CTA" |
| `script` | Full script (saved for reference) | Complete script text |

