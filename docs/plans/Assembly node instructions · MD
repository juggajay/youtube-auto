## Part 6: Assembly Node Implementation (index.ts)

```typescript
import { z } from 'zod';
import {
  NodeContract,
  NodeMeta,
  RunContext,
  NodeResult,
  ExecutionOptions,
  ValidationResult,
  CostEstimate,
  ApiCallLog,
} from '../base';
import {
  AssemblyInputSchema,
  AssemblyOutputSchema,
  AssemblyConfigSchema,
  AssemblyInput,
  AssemblyOutput,
  AssemblyConfig,
} from './types';
import { buildTimeline } from './timeline';
import { generateCaptions, generateSrt, generateVtt } from './captions';
import { renderVideo } from './ffmpeg';
import { mkdir, rm } from 'fs/promises';
import { randomUUID } from 'crypto';
import { join } from 'path';

export class AssemblyNode implements NodeContract<
  typeof AssemblyInputSchema,
  typeof AssemblyOutputSchema,
  typeof AssemblyConfigSchema
> {
  meta: NodeMeta = {
    id: 'assembly',
    name: 'Video Assembly',
    description: 'Combines audio, visuals, and captions into final video',
    icon: 'Film',
    category: 'production',
    requiredCredentials: ['pexels'],  // For stock footage
    estimatedDuration: '5-15min',
  };

  inputSchema = AssemblyInputSchema;
  outputSchema = AssemblyOutputSchema;
  configSchema = AssemblyConfigSchema;

  // === Get Input from Context ===

  getInputFromContext(context: RunContext): AssemblyInput {
    const script = context.previousOutputs.script;
    const voice = context.previousOutputs.voice;
    const thumbnail = context.previousOutputs.thumbnail;

    if (!script) throw new Error('Script output not found');
    if (!voice) throw new Error('Voice output not found');

    return {
      script: {
        title: script.title,
        hook: script.hook,
        sections: script.sections,
        outro: script.outro,
      },
      audioSegments: voice.segments,
      thumbnail: thumbnail?.options?.[0] 
        ? { imageUrl: thumbnail.options[0].imageUrl }
        : undefined,
      styleOverride: context.runOverrides.nodeOverrides?.assembly?.styleOverride,
    };
  }

  // === Validation ===

  validate(
    input: AssemblyInput,
    config: AssemblyConfig,
    context: RunContext
  ): ValidationResult {
    const errors: { field: string; message: string }[] = [];
    const warnings: { field: string; message: string }[] = [];

    // Check audio segments exist
    if (!input.audioSegments || input.audioSegments.length === 0) {
      errors.push({
        field: 'audioSegments',
        message: 'No audio segments provided',
      });
    }

    // Check script sections match audio
    const audioIds = new Set(input.audioSegments.map(a => a.id));
    for (const section of input.script.sections) {
      if (!audioIds.has(section.id)) {
        warnings.push({
          field: 'audioSegments',
          message: `No audio for section: ${section.name}`,
        });
      }
    }

    // Check assets exist if configured
    if (config.assets.introVideo && !config.assets.introVideo.startsWith('http')) {
      warnings.push({
        field: 'config.assets.introVideo',
        message: 'Intro video URL may be invalid',
      });
    }

    // Estimate render time warning
    const totalDuration = input.audioSegments.reduce((sum, s) => sum + s.durationSeconds, 0);
    if (totalDuration > 1800) {  // 30 minutes
      warnings.push({
        field: 'duration',
        message: `Long video (${Math.round(totalDuration / 60)} min) - rendering may take a while`,
      });
    }

    return { valid: errors.length === 0, errors, warnings };
  }

  // === Cost Estimation ===

  estimateCost(input: AssemblyInput, config: AssemblyConfig): CostEstimate {
    const totalDuration = input.audioSegments.reduce((sum, s) => sum + s.durationSeconds, 0);
    
    // Estimate based on visual source
    let visualCost = 0;
    const visualCount = Math.ceil(totalDuration / 7);  // One visual every 7 seconds

    switch (config.visualSource) {
      case 'stock':
        // Pexels is free, Storyblocks would have a cost
        visualCost = config.stockProvider === 'storyblocks' ? visualCount * 0.10 : 0;
        break;
      case 'ai_generated':
        visualCost = visualCount * 0.04;  // ~$0.04 per image
        break;
      case 'text_cards':
        visualCost = 0;  // Generated locally
        break;
      case 'mixed':
        visualCost = (visualCount / 2) * 0.04;  // Half AI, half text
        break;
    }

    // Compute cost (if using cloud rendering)
    const computeCost = 0;  // Self-hosted for now

    return {
      estimated: true,
      breakdown: [
        { service: 'visuals', units: visualCount, unitType: 'images', cost: visualCost },
        { service: 'compute', units: Math.ceil(totalDuration / 60), unitType: 'minutes', cost: computeCost },
      ],
      total: visualCost + computeCost,
      confidence: 'medium',
    };
  }

  // === Execution ===

  async execute(
    input: AssemblyInput,
    config: AssemblyConfig,
    context: RunContext,
    options?: ExecutionOptions
  ): Promise<NodeResult<AssemblyOutput>> {
    const startedAt = new Date();
    const apiCalls: ApiCallLog[] = [];
    
    // Create temporary work directory
    const workDir = join('/tmp', 'vidflow', context.runId, randomUUID());
    await mkdir(workDir, { recursive: true });

    try {
      // Check cancellation
      if (options?.signal?.aborted) {
        return {
          success: false,
          error: { code: 'CANCELLED', message: 'Cancelled by user', retryable: false },
        };
      }

      options?.onProgress?.({
        percent: 5,
        message: 'Building timeline...',
        stage: 'timeline',
      });

      // === Build Timeline ===
      const timeline = await buildTimeline({
        input,
        config,
      });

      options?.onLog?.({
        level: 'info',
        message: `Timeline built: ${timeline.segments.length} segments, ${timeline.totalDuration}s total`,
        timestamp: new Date(),
      });

      // Check cancellation
      if (options?.signal?.aborted) {
        await this.cleanup(workDir);
        return {
          success: false,
          error: { code: 'CANCELLED', message: 'Cancelled by user', retryable: false },
        };
      }

      // === Generate Captions ===
      options?.onProgress?.({
        percent: 10,
        message: 'Generating captions...',
        stage: 'captions',
      });

      const captions = generateCaptions(timeline.segments);
      const srtContent = generateSrt(captions);

      // Save SRT file
      const srtPath = join(workDir, 'subtitles.srt');
      await writeFile(srtPath, srtContent);

      // === Render Video ===
      const outputFileName = `${input.script.title.replace(/[^a-z0-9]/gi, '_')}.mp4`;
      const localOutputPath = join(workDir, outputFileName);

      const renderResult = await renderVideo({
        timeline: timeline.segments,
        config,
        outputPath: localOutputPath,
        workDir,
        onProgress: (percent, message) => {
          options?.onProgress?.({
            percent: 15 + (percent * 0.75),  // 15-90%
            message,
            stage: 'render',
          });
        },
      });

      // Check cancellation
      if (options?.signal?.aborted) {
        await this.cleanup(workDir);
        return {
          success: false,
          error: { code: 'CANCELLED', message: 'Cancelled by user', retryable: false },
        };
      }

      // === Upload to Storage ===
      options?.onProgress?.({
        percent: 92,
        message: 'Uploading video...',
        stage: 'upload',
      });

      const videoStoragePath = `runs/${context.runId}/video/${outputFileName}`;
      const videoUrl = await this.uploadFile(
        context.services.storage,
        videoStoragePath,
        localOutputPath
      );

      let subtitleUrl: string | undefined;
      let subtitlePath: string | undefined;

      if (config.generateSubtitleFile) {
        subtitlePath = `runs/${context.runId}/video/subtitles.srt`;
        subtitleUrl = await this.uploadFile(
          context.services.storage,
          subtitlePath,
          srtPath
        );
      }

      // === Cleanup ===
      options?.onProgress?.({
        percent: 98,
        message: 'Cleaning up...',
        stage: 'cleanup',
      });

      await this.cleanup(workDir);

      options?.onProgress?.({
        percent: 100,
        message: 'Assembly complete',
        stage: 'done',
      });

      const completedAt = new Date();
      const output: AssemblyOutput = {
        videoUrl,
        videoPath: videoStoragePath,
        subtitleUrl,
        subtitlePath,
        metadata: {
          duration: timeline.totalDuration,
          resolution: config.resolution,
          fileSize: renderResult.fileSize,
          format: config.format,
        },
        timeline: timeline.segments,
      };

      return {
        success: true,
        output,
        metadata: {
          startedAt,
          completedAt,
          durationMs: completedAt.getTime() - startedAt.getTime(),
          actualCost: this.estimateCost(input, config),  // Recalculate with actual counts
          apiCalls,
        },
      };

    } catch (error) {
      await this.cleanup(workDir);
      return {
        success: false,
        error: this.mapError(error),
      };
    }
  }

  // === Private Helpers ===

  private async uploadFile(
    storage: StorageClient,
    path: string,
    localPath: string
  ): Promise<string> {
    const fs = await import('fs/promises');
    const buffer = await fs.readFile(localPath);

    const contentType = path.endsWith('.mp4') ? 'video/mp4' :
                        path.endsWith('.srt') ? 'text/plain' : 
                        'application/octet-stream';

    const { error } = await storage.upload(path, buffer, {
      contentType,
      upsert: true,
    });

    if (error) {
      throw new Error(`Upload failed: ${error.message}`);
    }

    const { data } = storage.getPublicUrl(path);
    return data.publicUrl;
  }

  private async cleanup(workDir: string): Promise<void> {
    try {
      await rm(workDir, { recursive: true, force: true });
    } catch {
      // Ignore cleanup errors
    }
  }

  private mapError(error: unknown): { code: string; message: string; retryable: boolean } {
    const message = String(error);

    if (message.includes('ENOENT') || message.includes('not found')) {
      return { code: 'ASSET_NOT_FOUND', message: 'Required asset not found', retryable: false };
    }
    if (message.includes('ffmpeg')) {
      return { code: 'RENDER_ERROR', message: 'Video rendering failed', retryable: true };
    }
    if (message.includes('storage') || message.includes('upload')) {
      return { code: 'UPLOAD_ERROR', message: 'Failed to upload output', retryable: true };
    }

    return { code: 'ASSEMBLY_ERROR', message: String(error), retryable: true };
  }
}

// Helper
async function writeFile(path: string, content: string): Promise<void> {
  const fs = await import('fs/promises');
  await fs.writeFile(path, content, 'utf-8');
}

