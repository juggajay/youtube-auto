## Part 5: FFmpeg Wrapper (ffmpeg/index.ts)

```typescript
import { spawn, ChildProcess } from 'child_process';
import { EventEmitter } from 'events';
import { TimelineSegment, AssemblyConfig } from '../types';

export interface RenderOptions {
  timeline: TimelineSegment[];
  config: AssemblyConfig;
  outputPath: string;
  workDir: string;
  onProgress?: (percent: number, message: string) => void;
}

export interface RenderResult {
  outputPath: string;
  duration: number;
  fileSize: number;
}

/**
 * Render video using FFmpeg
 */
export async function renderVideo(options: RenderOptions): Promise<RenderResult> {
  const { timeline, config, outputPath, workDir, onProgress } = options;

  // Step 1: Download/prepare all assets
  onProgress?.(5, 'Preparing assets...');
  const preparedAssets = await prepareAssets(timeline, workDir, onProgress);

  // Step 2: Build FFmpeg filter complex
  onProgress?.(20, 'Building video filter...');
  const filterComplex = buildFilterComplex(timeline, preparedAssets, config);

  // Step 3: Build FFmpeg command
  const command = buildFfmpegCommand({
    inputs: preparedAssets.map(a => a.localPath),
    filterComplex,
    config,
    outputPath,
  });

  // Step 4: Execute FFmpeg
  onProgress?.(30, 'Rendering video...');
  await executeFfmpeg(command, (progress) => {
    // FFmpeg progress is 30-95%
    const mappedProgress = 30 + (progress * 0.65);
    onProgress?.(mappedProgress, `Rendering: ${Math.round(progress)}%`);
  });

  // Step 5: Get output info
  onProgress?.(95, 'Finalizing...');
  const fileStats = await getFileStats(outputPath);

  return {
    outputPath,
    duration: fileStats.duration,
    fileSize: fileStats.size,
  };
}

interface PreparedAsset {
  segmentId: string;
  visualIndex: number;
  type: 'video' | 'image' | 'audio';
  localPath: string;
  duration?: number;
}

async function prepareAssets(
  timeline: TimelineSegment[],
  workDir: string,
  onProgress?: (percent: number, message: string) => void
): Promise<PreparedAsset[]> {
  const assets: PreparedAsset[] = [];
  let assetIndex = 0;
  const totalAssets = timeline.reduce((sum, seg) => 
    sum + seg.visuals.length + (seg.audio ? 1 : 0), 0
  );

  for (const segment of timeline) {
    // Download audio
    if (segment.audio) {
      const audioPath = `${workDir}/audio_${segment.id}.mp3`;
      await downloadFile(segment.audio.url, audioPath);
      assets.push({
        segmentId: segment.id,
        visualIndex: -1,
        type: 'audio',
        localPath: audioPath,
      });
      assetIndex++;
      onProgress?.(5 + (assetIndex / totalAssets) * 15, `Downloading audio ${segment.id}...`);
    }

    // Download/generate visuals
    for (let i = 0; i < segment.visuals.length; i++) {
      const visual = segment.visuals[i];
      const visualPath = `${workDir}/visual_${segment.id}_${i}`;

      switch (visual.source.type) {
        case 'video':
          await downloadFile(visual.source.url, `${visualPath}.mp4`);
          assets.push({
            segmentId: segment.id,
            visualIndex: i,
            type: 'video',
            localPath: `${visualPath}.mp4`,
            duration: visual.duration,
          });
          break;

        case 'image':
          await downloadFile(visual.source.url, `${visualPath}.jpg`);
          assets.push({
            segmentId: segment.id,
            visualIndex: i,
            type: 'image',
            localPath: `${visualPath}.jpg`,
            duration: visual.duration,
          });
          break;

        case 'stock':
          // Fetch from stock provider
          const stockVideo = await fetchStockVideo(
            visual.source.provider,
            visual.source.query
          );
          await downloadFile(stockVideo.url, `${visualPath}.mp4`);
          assets.push({
            segmentId: segment.id,
            visualIndex: i,
            type: 'video',
            localPath: `${visualPath}.mp4`,
            duration: visual.duration,
          });
          break;

        case 'text_card':
          // Generate text card image
          const cardBuffer = await generateTextCard({
            text: visual.source.text,
            style: visual.source.style,
            width: 1920,
            height: 1080,
            backgroundColor: '#1a1a1a',
            textColor: '#ffffff',
            fontFamily: 'Inter',
          });
          await writeFile(`${visualPath}.png`, cardBuffer);
          assets.push({
            segmentId: segment.id,
            visualIndex: i,
            type: 'image',
            localPath: `${visualPath}.png`,
            duration: visual.duration,
          });
          break;

        case 'ai_generated':
          // Generate with AI (use thumbnail generator pattern)
          const aiImage = await generateAiImage(visual.source.prompt);
          await writeFile(`${visualPath}.png`, aiImage);
          assets.push({
            segmentId: segment.id,
            visualIndex: i,
            type: 'image',
            localPath: `${visualPath}.png`,
            duration: visual.duration,
          });
          break;
      }

      assetIndex++;
      onProgress?.(5 + (assetIndex / totalAssets) * 15, `Preparing visual ${i + 1}...`);
    }
  }

  return assets;
}

function buildFilterComplex(
  timeline: TimelineSegment[],
  assets: PreparedAsset[],
  config: AssemblyConfig
): string {
  const filters: string[] = [];
  const resolution = getResolution(config.resolution);
  
  // This is a simplified version - real implementation would be more complex
  // handling multiple layers, transitions, ken burns, etc.

  let videoStreams: string[] = [];
  let audioStreams: string[] = [];
  let inputIndex = 0;

  for (const segment of timeline) {
    const segmentAssets = assets.filter(a => a.segmentId === segment.id);
    
    // Handle visuals
    for (const visual of segmentAssets.filter(a => a.type !== 'audio')) {
      const inputLabel = `[${inputIndex}:v]`;
      const outputLabel = `[v${inputIndex}]`;

      if (visual.type === 'image') {
        // Scale and loop image for duration
        filters.push(
          `${inputLabel}loop=loop=-1:size=1:start=0,setpts=N/FRAME_RATE/TB,` +
          `scale=${resolution.width}:${resolution.height}:force_original_aspect_ratio=decrease,` +
          `pad=${resolution.width}:${resolution.height}:(ow-iw)/2:(oh-ih)/2,` +
          `trim=duration=${visual.duration}${outputLabel}`
        );
      } else {
        // Scale video
        filters.push(
          `${inputLabel}scale=${resolution.width}:${resolution.height}:force_original_aspect_ratio=decrease,` +
          `pad=${resolution.width}:${resolution.height}:(ow-iw)/2:(oh-ih)/2,` +
          `trim=duration=${visual.duration}${outputLabel}`
        );
      }

      videoStreams.push(outputLabel);
      inputIndex++;
    }

    // Handle audio
    const audioAsset = segmentAssets.find(a => a.type === 'audio');
    if (audioAsset) {
      const inputLabel = `[${inputIndex}:a]`;
      const outputLabel = `[a${inputIndex}]`;
      
      // Apply volume and fades
      const fadeIn = segment.audio?.fadeIn ?? 0;
      const fadeOut = segment.audio?.fadeOut ?? 0;
      const volume = segment.audio?.volume ?? 1.0;
      
      filters.push(
        `${inputLabel}volume=${volume},` +
        `afade=t=in:st=0:d=${fadeIn},` +
        `afade=t=out:st=${segment.duration - fadeOut}:d=${fadeOut}${outputLabel}`
      );

      audioStreams.push(outputLabel);
      inputIndex++;
    }
  }

  // Concatenate all streams
  if (videoStreams.length > 0) {
    filters.push(
      `${videoStreams.join('')}concat=n=${videoStreams.length}:v=1:a=0[outv]`
    );
  }

  if (audioStreams.length > 0) {
    filters.push(
      `${audioStreams.join('')}concat=n=${audioStreams.length}:v=0:a=1[outa]`
    );
  }

  // Add background music if configured
  if (config.assets.backgroundMusic) {
    filters.push(
      `[outa][${inputIndex}:a]amix=inputs=2:duration=first:dropout_transition=2,` +
      `volume=${config.assets.backgroundMusicVolume}[outa_music]`
    );
  }

  return filters.join(';');
}

interface FfmpegCommandOptions {
  inputs: string[];
  filterComplex: string;
  config: AssemblyConfig;
  outputPath: string;
}

function buildFfmpegCommand(options: FfmpegCommandOptions): string[] {
  const { inputs, filterComplex, config, outputPath } = options;
  const resolution = getResolution(config.resolution);

  const args: string[] = ['-y'];  // Overwrite output

  // Add inputs
  for (const input of inputs) {
    args.push('-i', input);
  }

  // Add background music if configured
  if (config.assets.backgroundMusic) {
    args.push('-i', config.assets.backgroundMusic);
  }

  // Filter complex
  args.push('-filter_complex', filterComplex);

  // Map outputs
  args.push('-map', '[outv]');
  args.push('-map', config.assets.backgroundMusic ? '[outa_music]' : '[outa]');

  // Video codec
  args.push('-c:v', 'libx264');
  args.push('-preset', config.preset);
  args.push('-b:v', config.videoBitrate);
  args.push('-pix_fmt', 'yuv420p');

  // Audio codec
  args.push('-c:a', 'aac');
  args.push('-b:a', config.audioBitrate);

  // Frame rate
  args.push('-r', String(config.frameRate));

  // Output
  args.push(outputPath);

  return args;
}

function executeFfmpeg(
  args: string[],
  onProgress?: (percent: number) => void
): Promise<void> {
  return new Promise((resolve, reject) => {
    const process = spawn('ffmpeg', args);

    let duration = 0;

    process.stderr.on('data', (data: Buffer) => {
      const line = data.toString();

      // Parse duration
      const durationMatch = line.match(/Duration: (\d{2}):(\d{2}):(\d{2})/);
      if (durationMatch) {
        const [, hours, minutes, seconds] = durationMatch;
        duration = parseInt(hours) * 3600 + parseInt(minutes) * 60 + parseInt(seconds);
      }

      // Parse progress
      const timeMatch = line.match(/time=(\d{2}):(\d{2}):(\d{2})/);
      if (timeMatch && duration > 0) {
        const [, hours, minutes, seconds] = timeMatch;
        const currentTime = parseInt(hours) * 3600 + parseInt(minutes) * 60 + parseInt(seconds);
        const percent = (currentTime / duration) * 100;
        onProgress?.(Math.min(percent, 100));
      }
    });

    process.on('close', (code) => {
      if (code === 0) {
        resolve();
      } else {
        reject(new Error(`FFmpeg exited with code ${code}`));
      }
    });

    process.on('error', reject);
  });
}

function getResolution(preset: '720p' | '1080p' | '4k'): { width: number; height: number } {
  switch (preset) {
    case '720p': return { width: 1280, height: 720 };
    case '1080p': return { width: 1920, height: 1080 };
    case '4k': return { width: 3840, height: 2160 };
  }
}

