## Config Schema

Update the Script Node config to match the simplified structure:

```typescript
interface ScriptNodeConfig {
  // Content Tab
  hookSource: 'library' | 'generate';
  hookContentId?: string;  // If source = 'library'
  
  titleSource: 'library' | 'generate';
  titleContentId?: string;  // If source = 'library'
  
  descriptionSource: 'library' | 'template' | 'generate';
  descriptionContentId?: string;  // If source = 'library'
  descriptionTemplate?: string;   // If source = 'template'
  
  autoGenerateTags: boolean;
  requiredTags: string[];
  
  // Generation Tab
  archetype: string;       // tutorial, listicle, explainer, etc.
  targetDuration: string;  // short, standard, long, custom
  customDurationMin?: number;
  customDurationMax?: number;
  
  model: 'claude-sonnet-4' | 'claude-opus-4';
  temperature: number;  // 0.3 to 1.0
  
  useChannelBible: boolean;
  
  // Advanced Tab
  sections: {
    hook: boolean;
    introduction: boolean;
    mainContent: boolean;
    conclusion: boolean;
    callToAction: boolean;
  };
  
  customInstructions?: string;
  
  includeTimestamps: boolean;
  includeSectionHeaders: boolean;
  includeBrollSuggestions: boolean;
}
```

